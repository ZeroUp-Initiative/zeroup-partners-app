rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user is an admin-approved partner school
    function isApprovedSchool() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'school' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolStatus == 'approved';
    }

    // Fields only the server or an admin may set on a user document. A user who
    // could edit dreamerDashUserId could spend another Dreamer's coins.
    function protectedUserFields() {
      return ['role', 'schoolStatus', 'isDreamer', 'dreamerDashUserId', 'dreamerTelegramId',
              'dreamerUsername', 'dreamerLinkedAt', 'orgId', 'orgStatus'];
    }

    // Users collection. Private: names and photos for public pages are served
    // by /api/community, which never includes emails, Telegram ids or push tokens.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Sign-up: a plain user, or an unapproved school application.
      allow create: if isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role in ['user', 'school']) &&
        (!('schoolStatus' in request.resource.data) || request.resource.data.schoolStatus == 'pending') &&
        !request.resource.data.keys().hasAny(['isDreamer', 'dreamerDashUserId', 'dreamerTelegramId',
          'dreamerUsername', 'dreamerLinkedAt', 'orgId', 'orgStatus']);

      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedUserFields());

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Payments/Contributions collection. Private: public totals come from /api/community.
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();

      // Partners log their own pending contribution, with display fields only
      // (never award flags or review fields) and a positive amount.
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.amount is number && request.resource.data.amount > 0 &&
        request.resource.data.keys().hasOnly(['userId', 'userFirstName', 'userLastName', 'userFullName', 'userEmail',
          'amount', 'date', 'description', 'projectId', 'projectTitle', 'proofURL', 'status',
          'referrerDreamerId', 'createdAt', 'message', 'isSoloSponsor']);

      // Admins review contributions, but never their own.
      allow update: if isAdmin() && resource.data.userId != request.auth.uid;
      allow delete: if isAdmin() && resource.data.userId != request.auth.uid;
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if true;

      // Created by admins, or by the server from an approved case or organization proposal.
      allow create: if isAdmin();

      // Any admin can manage any project (including funding totals on approval).
      allow update: if isAdmin();

      // A non-admin owner may edit the narrative only: never the goal, amount
      // raised, status, ownership or review fields. Organizations go through
      // the server instead, so suspending one takes effect immediately.
      allow update: if isAuthenticated() && resource.data.submittedBy == request.auth.uid &&
        !('ownerOrgId' in resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'story', 'videoUrl', 'gallery',
          'timeline', 'imageUrl', 'category', 'location', 'phase', 'background', 'expectedBeneficiaries',
          'expectedOutcomes', 'contactName', 'contactEmail', 'contactPhone', 'updatedAt']);

      allow delete: if isAdmin();
    }

    // Organization accounts and their project proposals: server-only.
    match /organizations/{orgId} {
      allow read, write: if false;
    }
    match /orgProposals/{proposalId} {
      allow read, write: if false;
    }

    // Education Cases collection — a real, specific need submitted by an
    // admin-approved partner school. Not publicly readable: the resulting
    // Project (once admin converts a verified case) is the public artifact,
    // not the case itself.
    match /cases/{caseId} {
      // The submitting school can read its own cases.
      allow read: if isAuthenticated() && resource.data.schoolId == request.auth.uid;

      // Admins can read all cases.
      allow read: if isAdmin();

      // Only an approved school can submit a case, tagged as itself, starting
      // in the "submitted" state.
      allow create: if isApprovedSchool() &&
        request.resource.data.schoolId == request.auth.uid &&
        request.resource.data.status == 'submitted';

      // The owning school may edit and resubmit while it's still under
      // review (submitted / needs_info) — but may only set status back to
      // "submitted", never verify/publish/reject itself. Once published, the
      // school may submit a post-funding outcome update, but only admin can
      // publish it (flip to "closed") onto the public project. Admins may
      // update any field (status transitions, notes, projectId linkage).
      allow update: if (
        isAuthenticated() && resource.data.schoolId == request.auth.uid &&
        (
          (resource.data.status in ['submitted', 'needs_info'] && request.resource.data.status == 'submitted') ||
          (resource.data.status == 'published' && request.resource.data.status == 'outcome_submitted')
        )
      ) || isAdmin();

      // The owning school may withdraw a case only before review has begun;
      // admins may delete any case.
      allow delete: if (
        isAuthenticated() && resource.data.schoolId == request.auth.uid && resource.data.status == 'submitted'
      ) || isAdmin();
    }

    // Lightweight leads from any partner flagging a need they know about —
    // not a public submission, just a pointer for admin to follow up on.
    match /referrals/{referralId} {
      allow create: if isAuthenticated() && request.resource.data.submittedBy == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // System/Admin can create notifications
      allow create: if isAdmin();
      
      // Users can update their own notifications (mark as read)
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Users can delete their own notifications
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Community-wide milestones (₦ funding / partner count thresholds reached).
    // Written only by the server (service account bypasses these rules) when a
    // threshold is crossed — see app/api/milestones/*.
    match /milestones/{milestoneId} {
      allow read: if true;
      allow write: if false;
    }

    // Per-partner badges awarded when a milestone is reached. Claiming (which
    // also credits DR for linked Dreamers) happens server-side via
    // /api/badges/claim, not directly from the client — so no client write here.
    match /badges/{badgeId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // Gamification/Coins collection (future use)
    match /userCoins/{userId} {
      allow read: if isOwner(userId);
      allow write: if isAdmin(); // Only system can update coins
    }
    
    // Achievements collection (future use)
    match /achievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // User achievements (future use)
    match /userAchievements/{docId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Notification preferences collection
    match /notificationPreferences/{userId} {
      // Users can read and write their own preferences
      allow read, write: if isOwner(userId);

      // Admins can read all preferences
      allow read: if isAdmin();
    }

    // Email templates - readable by anyone (not sensitive), writable by admins only
    match /emailTemplates/{templateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // App settings - admin only
    match /settings/{settingId} {
      allow read, write: if isAdmin();
    }
  }
}
